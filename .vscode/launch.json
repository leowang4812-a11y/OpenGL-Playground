{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OpenGL App (MSYS2)",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/bin/main.exe",
            "args": [],
            "stopAtEntry": false,

            "cwd": "${workspaceFolder}",

            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],

            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",

            "preLaunchTask": "build",

            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}