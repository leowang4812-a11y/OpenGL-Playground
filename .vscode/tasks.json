{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}",
                }
            },
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "bin/glad.o",
                "src/main.cpp",

                "-o",
                "bin/main.exe",

                "-Ibin",
                "-Iinclude",

                "-Iinclude/asset_managers",
                "-Iinclude/renderer",
                "-Ithird_party",

                "-include",
                "pch.h",

                "-IC:/msys64/ucrt64/include",
                "-LC:/msys64/ucrt64/lib",

                "-lglfw3",
                "-lopengl32",
                "-lassimp",
                "-std=c++20",
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "bin\\main.exe",
            "dependsOn": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "build pch",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}",
                }
            },
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-g",
                "-O0",

                "-std=c++20",

                "-Ibin",
                "-Iinclude",

                "-Iinclude/asset_managers",
                "-Iinclude/renderer",
                "-Ithird_party",

                "-IC:/msys64/ucrt64/include",

                "-x",
                "c++-header",

                "include/pch.h",

                "-o",
                "include/pch.h.gch"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build and run",
      "type": "shell",
      "command": "clang++ -std=c++20 -arch arm64 \"${file}\" -Iinclude -o \"${fileDirname}/${fileBasenameNoExtension}\" -I/opt/homebrew/include -L/opt/homebrew/lib -lGLEW -lglfw -framework OpenGL -framework Cocoa -framework IOKit && \"${fileDirname}/${fileBasenameNoExtension}\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}